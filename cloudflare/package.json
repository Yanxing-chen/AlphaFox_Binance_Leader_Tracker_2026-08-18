{
  "name": "binance-leader-tracker-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/worker.js",
    "poll:dry-run": "node scripts/fetch_and_ingest.js --dry-run",
    "poll:ingest": "node scripts/fetch_and_ingest.js",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create leader_tracker_db",
    "d1:migrate:local": "wrangler d1 execute leader_tracker_db --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute leader_tracker_db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
